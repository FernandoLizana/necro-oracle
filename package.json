{
  "name": "necro-oracle",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "tree-sitter-javascript": "0.25.0"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @necro/web dev",
    "build": "pnpm -r build",
    "lint": "eslint \"**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:pbt": "vitest run --reporter=verbose",
    "e2e": "pnpm --filter @necro/web e2e",
    "demo:bundle": "tsx --import ./scripts/demo-bundle/css-stub-register.mjs scripts/demo-bundle/generate.ts",
    "smoke:llm": "tsx scripts/smoke-llm/smoke.ts",
    "size-limit": "pnpm --filter @necro/oracle size"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "fast-check": "^3.23.1",
    "tsx": "4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
